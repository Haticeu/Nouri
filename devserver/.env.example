# Copy this file to `.env` (same folder). Never commit `.env`.

# Open Food Facts asks every app to identify itself: AppName/Version (contact).
# OFF_USER_AGENT=Nouri/0.1 (you@example.com)

# AI features are OFF (no paid AI calls). To try photo analysis locally anyway,
# set AI_FEATURES=on and ONE of the options below.
# AI_FEATURES=on
# Option 1: Claude reads the meal photos (key from https://console.anthropic.com).
# ANTHROPIC_API_KEY=
# Option 2: your own model; see supabase/functions/analyze-meal/analyze.mjs.
# MEAL_ANALYZER_URL=http://localhost:8000/analyze
# MEAL_ANALYZER_TOKEN=